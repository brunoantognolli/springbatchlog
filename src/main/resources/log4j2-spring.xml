<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{jobName}] - %msg%n</Property>
        <Property name="BASE_LOG_DIR">logs</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>
        
        <!-- Main application log file -->
        <RollingFile name="MainFileAppender" fileName="${BASE_LOG_DIR}/application.log"
                     filePattern="${BASE_LOG_DIR}/application-%d{yyyy-MM-dd}-%i.log">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy />
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>
            <DefaultRolloverStrategy max="10"/>
        </RollingFile>

        <!-- Dynamic job-specific log file -->
        <Routing name="JobRoutingAppender">
            <Routes pattern="$${ctx:jobName}">
                <Route>
                    <RollingFile name="JobFile-${ctx:jobName}" 
                                fileName="${BASE_LOG_DIR}/jobs/${ctx:jobName}/job.log"
                                filePattern="${BASE_LOG_DIR}/jobs/${ctx:jobName}/job-%d{yyyy-MM-dd}-%i.log">
                        <PatternLayout pattern="${LOG_PATTERN}"/>
                        <Policies>
                            <TimeBasedTriggeringPolicy />
                            <SizeBasedTriggeringPolicy size="10MB"/>
                        </Policies>
                        <DefaultRolloverStrategy max="10"/>
                    </RollingFile>
                </Route>
                <Route key="$${ctx:jobName}">
                    <RollingFile name="JobFile-default" 
                                fileName="${BASE_LOG_DIR}/jobs/unknown/job.log"
                                filePattern="${BASE_LOG_DIR}/jobs/unknown/job-%d{yyyy-MM-dd}-%i.log">
                        <PatternLayout pattern="${LOG_PATTERN}"/>
                        <Policies>
                            <TimeBasedTriggeringPolicy />
                            <SizeBasedTriggeringPolicy size="10MB"/>
                        </Policies>
                        <DefaultRolloverStrategy max="10"/>
                    </RollingFile>
                </Route>
            </Routes>
        </Routing>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="MainFileAppender"/>
        </Root>
        
        <Logger name="com.example.springbatchlog" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="MainFileAppender"/>
            <AppenderRef ref="JobRoutingAppender"/>
        </Logger>
    </Loggers>
</Configuration> 